    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run npm build",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run build",
            "cwd": "${workspaceFolder}/VoteMania/voting/static/voting/front_debag",
            "console": "internalConsole"
        },

        
        {
            "name": "Django servec start",
            "justMyCode": false,
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/VoteMania/manage.py",
            "python": "${command:python.interpreterPath}",
            "args": [
                "runserver",
                //"--noreload",
                //"0.0.0.0:8001",
            ],
            "django": true
        }
    ]
}